import os
from langchain_chroma import Chroma
from langchain_openai import ChatOpenAI
from langchain_ollama import OllamaEmbeddings
from langchain_text_splitters import CharacterTextSplitter
from langchain_core.prompts import ChatPromptTemplate
from langchain_core.runnables import RunnablePassthrough
from langchain_core.output_parsers import StrOutputParser


# 1. 准备数据：切分文本
text_splitter = CharacterTextSplitter(chunk_size=1000, chunk_overlap=0)

documents = text_splitter.create_documents([
    "LangChain 是一个用于构建 LLM 应用的框架。",
    "Chroma 是一个开源的向量数据库，用于存储和检索向量。",
    "RAG 是检索增强生成，先检索相关文档，再让 LLM 生成回答。"
])

# 嵌入模型：专门做向量转化的
embedding_model = OllamaEmbeddings(model="nomic-embed-text")

# ========== LLM：远程 DeepSeek API，需要 Key ==========
llm = ChatOpenAI(
    model="deepseek-v4-pro",
    base_url="https://api.deepseek.com",   # DeepSeek 官方地址[citation:3][citation:15]
    api_key=os.environ.get("DEEPSEEK_API_KEY")  # 从环境变量读
)

# 2. 存入 Chroma（同时完成嵌入和持久化）
vectorstore = Chroma.from_documents(
    documents=documents,
    embedding=embedding_model,
    persist_directory="./chroma_langchain_db"  # 数据保存到本地
)

# 4. 验证
print(vectorstore.similarity_search("test", k=1))

# 3. 创建检索器
retriever = vectorstore.as_retriever(search_kwargs={"k": 3})

# 4. 定义提示词模板（旧版是 RetrievalQA 内部自动拼的，现在要显式写出来）
prompt = ChatPromptTemplate.from_template(
    """Answer the question based only on the following context:
{context}

Question: {question}
"""
)

# 5. 把检索到的 Document 列表拼成纯文本
def format_docs(docs):
    return "\n\n".join(doc.page_content for doc in docs)

# 6. 用 LCEL 组装链
qa_chain = (
    {"context": retriever | format_docs, "question": RunnablePassthrough()}
    | prompt
    | llm
    | StrOutputParser()
)

# 7. 提问
response = qa_chain.invoke("什么是LangChain?")
print(response)
print(qa_chain.invoke("今天天气怎么样？"))